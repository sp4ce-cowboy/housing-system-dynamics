<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>IERevisedSFD</name>
		<uuid>eed773d1-f4f7-4725-8d05-452b96d4f2dc</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.4.1" isee:build_number="3048" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.15" isee:restore_on_start="false" method="Euler" time_units="Year" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>0</start>
		<stop>10</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs saved_runs="5" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<isee:sensi_specs_list active_index="0">
		<isee:sensi_specs name="Sensitivity" method="sobol_sequence" runs="5">
			<isee:variable starting_value="17500" ending_value="35000" type="incremental" min="17500" max="35000" seed="12345" name="Number_of_Houses_Available" num_samples="5"/>
		</isee:sensi_specs>
	</isee:sensi_specs_list>
	<isee:optimizer_specs_list active_index="0">
		<isee:optimizer_specs name="Optimization" method="Powell" use_additional_starts_file="false" additional_starts="0" report_interval="1" confidence_range="0"/>
	</isee:optimizer_specs_list>
	<isee:payoff_specs_list>
		<isee:payoff_specs name="Payoff"/>
	</isee:payoff_specs_list>
	<model_units>
		<unit name="People">
			<eqn/>
			<alias>person</alias>
			<alias>persons</alias>
		</unit>
		<unit name="$">
			<eqn/>
			<alias>dollar</alias>
			<alias>dollars</alias>
		</unit>
		<unit name="Dollars Per Year">
			<eqn>$/Years</eqn>
			<alias>Dollar Per Year</alias>
			<alias>$ per year</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
		</unit>
		<unit name="kilowatt hours per day">
			<eqn>kWh/day</eqn>
		</unit>
		<unit name="kilowatts">
			<eqn>kW</eqn>
			<alias>kilowatt</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<flow name="Change in Rate of\nConstruction">
				<eqn>MAX(DELAY(&quot;Government_Intervention_(Interest_Rate_Easing)&quot;*Construction_Rate, 7 * Incentive_for_Supply_Policy, 0), Discrepancy_for_Rate_of_Construction)</eqn>
				<units>Houses Per Year/Year</units>
			</flow>
			<stock name="Construction Rate">
				<eqn>75000</eqn>
				<inflow>Change_in_Rate_of_Construction</inflow>
				<non_negative/>
				<units>Houses Per Year</units>
			</stock>
			<aux name="Incentive for Supply Policy">
				<eqn>1 / (.5 + (Demand_for_Housing * 0.25))</eqn>
				<units/>
			</aux>
			<aux name="Government Intervention\n(Interest Rate Easing)">
				<eqn>0.1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Maximum Rate of\nConstruction">
				<eqn>IF(Maximum_Number_of_Houses_that_can_be_built &gt; 0) THEN(85000) ELSE (0)</eqn>
			</aux>
			<aux name="Discrepancy for Rate\nof Construction">
				<eqn>Maximum_Rate_of_Construction-Construction_Rate</eqn>
				<units>unitless</units>
			</aux>
			<flow name="Increase in Houses Built">
				<eqn>Construction_Rate/10</eqn>
				<non_negative/>
				<units>Houses/Year</units>
			</flow>
			<stock name="Number of Houses\nAvailable">
				<eqn>17500</eqn>
				<inflow>Increase_in_Houses_Built</inflow>
				<non_negative/>
				<units>Houses</units>
			</stock>
			<stock name="Number of Houses\nDemanded">
				<eqn>1000</eqn>
				<inflow>Change_in_Number_of_Houses_Demanded</inflow>
				<non_negative/>
				<units>Houses</units>
			</stock>
			<flow name="Change in Number of Houses Demanded">
				<eqn>Maximum_Houses_Demanded*DELAYN(Demand_for_Housing,  0.5, 2, 0)</eqn>
				<units>Houses/Year</units>
			</flow>
			<aux name="Demand for Housing">
				<eqn>0.5 * (Rental_Price/(30000-9600)) + 0.5* (&quot;Government_Intervention_(Amount_in_Grants_per_person)&quot; / (40000 - 0)) - (0.5 * (&quot;Current_Price_to_Income_Ratio_(Housing_Unaffordability)&quot; / (20 - 6)))</eqn>
			</aux>
			<aux name="Rental Price">
				<eqn>12000 + (12000 * 1/Rental_Demand)</eqn>
				<units>Dollars Per Year</units>
			</aux>
			<aux name="Demand to Supply Ratio">
				<eqn>Number_of_Houses_Demanded / Number_of_Houses_Available</eqn>
			</aux>
			<aux name="Housing Price">
				<eqn>(200000 + (200000 * Demand_to_Supply_Ratio)) - &quot;Government_Intervention_(Amount_in_Grants_per_person)&quot;</eqn>
			</aux>
			<aux name="Maximum\nHouses Demanded">
				<eqn>IF(Median_Annual_Income &gt; 70000) THEN(Eligible_Proportion_of_Singles_for_Government_Grants * &quot;Proportion_of_Singles_Aged_30_-_40&quot;) ELSE (1.5 *Eligible_Proportion_of_Singles_for_Government_Grants * &quot;Proportion_of_Singles_Aged_30_-_40&quot;)</eqn>
			</aux>
			<aux name="Current Price to Income Ratio\n(Housing Unaffordability)">
				<eqn>Housing_Price/Median_Annual_Income</eqn>
				<units>Years</units>
			</aux>
			<aux name="Rental Demand">
				<eqn>&quot;Current_Price_to_Income_Ratio_(Housing_Unaffordability)&quot;</eqn>
			</aux>
			<aux name="Maximum Number of Houses that can be built">
				<eqn>500000 - (Number_of_Houses_Available)</eqn>
				<units>Houses</units>
			</aux>
			<flow name="Economic Growth Rate">
				<eqn>(((3.6 / 100) + Immigration_Rate) * Gross_Domestic_Product)</eqn>
				<non_negative/>
				<units>Dollars Per Year/Year</units>
			</flow>
			<flow name="Immigration">
				<eqn>Immigration_Rate * Singapore_Population</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<flow name="Births">
				<eqn>Birth_Rate * Singapore_Population</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<flow name="Deaths">
				<eqn>Death_Rate * Singapore_Population</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<stock name="Gross Domestic Product">
				<eqn>(466790000000)</eqn>
				<inflow>Economic_Growth_Rate</inflow>
				<non_negative/>
				<units>Dollars Per Year</units>
			</stock>
			<stock name="Singapore Population">
				<eqn>6014723</eqn>
				<inflow>Births</inflow>
				<inflow>Immigration</inflow>
				<outflow>Deaths</outflow>
				<non_negative/>
				<units>People</units>
			</stock>
			<aux name="Median Annual Income">
				<eqn>60704 + (Economic_Growth_Rate/6014723)</eqn>
				<units>Dollars Per Year</units>
			</aux>
			<aux name="Proportion of\nSingles Aged 30 - 40">
				<eqn>0.0534 * Singapore_Population</eqn>
			</aux>
			<aux name="Immigration Rate">
				<eqn>(4.532/1000)</eqn>
			</aux>
			<aux name="Death Rate">
				<eqn>5.2/1000</eqn>
			</aux>
			<aux name="Birth Rate">
				<eqn>8.33/1000</eqn>
			</aux>
			<aux name="Eligible Proportion of Singles\nfor Government Grants">
				<eqn>7.5/100</eqn>
			</aux>
			<aux name="Government\nIntervention (Amount in Grants per person)">
				<eqn>40000</eqn>
				<units>Dollars</units>
			</aux>
		</variables>
